# ====================================================
# PropertyManagementSystem — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ====================================================

# ── App ────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # production | development

# ── Database (PostgreSQL) ──────────────────────────
# Neon: postgres://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# Supabase: postgres://postgres:pass@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/property_management_db

# ── Redis ──────────────────────────────────────────
# Upstash (free): rediss://default:xxx@xxx.upstash.io:6379
# Render Redis (free): redis://red-xxx.render.com:6379
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ───────────────────────────────────────────
# Production frontend URL (used for email links, CORS)
FRONTEND_URL=http://localhost:5173

# ── Email (Nodemailer) ─────────────────────────────
# Gmail: Use an App Password (not your normal password)
# Mailtrap (dev): smtp.mailtrap.io:587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Stripe (Payments) ─────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Logging ────────────────────────────────────────
LOG_LEVEL=info   # error | warn | info | debug
